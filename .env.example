# Qawla — Environment Variables
# Copy to `.env` and fill in. Never commit `.env`.

# ─── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://qawla.com
NODE_ENV=development

# ─── Admin auth ────────────────────────────────────────────────────────────
# HMAC secret for signing admin session JWTs. Must be >= 32 chars.
# Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Default admin credentials (for dev only — production uses Firestore)
ADMIN_EMAIL=editor@qawla.com
ADMIN_PASSWORD=qawla2025

# ─── Firebase / Firestore (optional — app works without these) ─────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the entire private key including BEGIN/END headers.
# Use \n for newlines if your shell mangles them.
FIREBASE_PRIVATE_KEY=

# ─── AI providers (waterfall: Nvidia NIM → Groq → Gemini) ──────────────────
# At least one is required for the pipeline to run.
#
# Provider 1: Nvidia NIM — hosts Kimi K2 (moonshotai/kimi-k2.6-instruct) for FREE
#   Get a free key at https://build.nvidia.com (no credit card required)
#   This is the FREE way to use Kimi K2 — no paid Moonshot API key needed.
NVIDIA_API_KEY=
#
# Provider 2: Groq — Llama 3.3 70B, very fast, generous free tier
#   Get a free key at https://console.groq.com
GROQ_API_KEY=
#
# Provider 3: Gemini 1.5 Pro — Google's free tier
#   Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Tavily (web search for fact-checking) ─────────────────────────────────
# Used by the Fact-Checker agent to cross-reference claims against live web content.
# Free tier: 1,000 searches/month at https://tavily.com
TAVILY_API_KEY=

# ─── Football-Data.org (live matches + standings) ──────────────────────────
# Free tier: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# ─── Lemon Squeezy (donations) ─────────────────────────────────────────────
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_STORE_SLUG=qawla
LEMONSQUEEZY_WEBHOOK_SECRET=

# ─── Cron (the /api/cron endpoint) ─────────────────────────────────────────
# Set this to a random string — pass it as X-Cron-Secret header.
CRON_SECRET=replace-with-a-random-string

# ─── Analytics (optional) ──────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=qawla.com
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Cloudflare (production) ───────────────────────────────────────────────
# These are set via `wrangler secret put` — do not commit them.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
